<settings>
  <category id="profiles" label="Profiles (Multi-Device)">
    <setting id="profiles_manage" type="action" label="Manage Profiles…" action="RunScript(special://home/addons/plugin.service.favourites-sync/resources/lib/ui_profiles.py)" option="close"/>
    <setting type="sep"/>
    <setting type="lsep" label="Multi-Profile Sync"/>
    <setting type="label" label="Configure sync settings for each Kodi profile."/>
    <setting type="label" label="Each profile can have its own cloud backend and schedule."/>
  </category>
  <category id="cloud" label="Location (Required)">
    <setting id="backend" type="enum" label="Type" values="WebDAV|S3|HTTP(S)|SFTP|SMB/NAS|NFS|Local Path" default="0"/>
    <setting id="webdav_url" type="text" label="WebDAV URL" default="" visible="eq(-1,0)"/>
    <setting id="webdav_path" type="text" label="Path to file" default="/kodi/favourites/{profile}/favourites.xml" visible="eq(-2,0)"/>
    <setting id="webdav_user" type="text" label="Username" default="" visible="eq(-3,0)"/>
    <setting id="webdav_password" type="text" option="hidden" label="Password" default="" visible="eq(-4,0)"/>
    <setting id="tls_verify" type="bool" label="Validate TLS certificates" default="true" visible="eq(-5,0)"/>
    <setting id="custom_ca" type="text" label="Custom CA bundle path" default="" visible="eq(-6,0)"/>
    <setting id="s3_endpoint" type="text" label="S3 Endpoint (e.g., s3.amazonaws.com)" default="" visible="eq(-7,1)"/>
    <setting id="s3_region" type="text" label="S3 Region" default="us-east-1" visible="eq(-8,1)"/>
    <setting id="s3_bucket" type="text" label="Bucket" default="" visible="eq(-9,1)"/>
    <setting id="s3_key" type="text" label="Object Key" default="kodi/favourites/{profile}/favourites.xml" visible="eq(-10,1)"/>
    <setting id="s3_access" type="text" label="Access Key" default="" visible="eq(-11,1)"/>
    <setting id="s3_secret" type="text" option="hidden" label="Secret Key" default="" visible="eq(-12,1)"/>
    <setting id="s3_versioning" type="bool" label="Bucket has versioning enabled" default="true" visible="eq(-13,1)"/>
    <setting id="http_get" type="text" label="GET URL" default="" visible="eq(-14,2)"/>
    <setting id="http_put" type="text" label="PUT URL" default="" visible="eq(-15,2)"/>
    <setting id="http_auth_header" type="text" label="Auth Header (optional)" default="" visible="eq(-16,2)"/>
    <setting id="sftp_host" type="text" label="SFTP Host" default="" visible="eq(-17,3)"/>
    <setting id="sftp_port" type="number" label="Port" default="22" visible="eq(-18,3)"/>
    <setting id="sftp_user" type="text" label="Username" default="" visible="eq(-19,3)"/>
    <setting id="sftp_password" type="text" option="hidden" label="Password (or leave empty for key)" default="" visible="eq(-20,3)"/>
    <setting id="sftp_keyfile" type="file" label="Private Key (optional)" default="" visible="eq(-21,3)"/>
    <setting id="sftp_path" type="text" label="Remote Path" default="/mnt/data/kodi/favourites/{profile}/favourites.xml" visible="eq(-22,3)"/>
    <setting id="smb_path" type="text" label="UNC Path (e.g., \\NAS\share\kodi\favourites\{profile}\favourites.xml)" default="" visible="eq(-23,4)"/>
    <setting id="smb_user" type="text" label="Username (optional)" default="" visible="eq(-24,4)"/>
    <setting id="smb_password" type="text" option="hidden" label="Password (optional)" default="" visible="eq(-25,4)"/>
    <setting id="nfs_path" type="text" label="NFS Path (or mounted local path)" default="nfs://nas.local/export/kodi/favourites/{profile}/favourites.xml" visible="eq(-26,5)"/>
    <setting id="local_path" type="file" label="Local (synced) file path" default="" visible="eq(-27,6)"/>
    <setting id="validate_button" type="action" label="Validate endpoint" action="RunScript(special://home/addons/plugin.service.favourites-sync/resources/lib/validate_action.py)" option="close"/>
    <setting id="test_button" type="action" label="TEST - Run synchronization" action="RunScript(special://home/addons/plugin.service.favourites-sync/resources/lib/addon.py)" option="close"/>
  </category>
  <category id="schedule" label="Scheduling">
    <setting id="schedule_enabled" type="bool" label="Enable automatic sync" default="false"/>
    <setting id="schedule_mode" type="enum" label="Schedule mode" values="On startup only|On shutdown only|On startup and shutdown" default="0" visible="eq(-1,true)"/>
    <setting id="startup_delay_seconds" type="number" label="Startup delay (seconds 2-40)" default="5" option="int" min="2" max="40" visible="[eq(-1,0) | eq(-1,2)] + eq(-2,true)"/>
    <setting id="scheduled_mode" type="enum" label="Default sync mode" values="Pull (Cloud→Local)|Push (Local→Cloud)|Bidirectional" default="0" visible="eq(-3,true)"/>
  </category>
  <category id="conflict" label="Conflict Policy">
    <setting id="conflict_policy" type="enum" label="Default policy for bidirectional" values="Prefer Cloud|Prefer Local|Bidirectional Merge|Manual Review" default="0"/>
    <setting id="scheduled_conflict" type="enum" label="When conflict occurs on schedule" values="Prefer Cloud|Prefer Local|Skip &amp; notify" default="0"/>
  </category>
  <category id="backups" label="Backups">
    <setting id="local_backups" type="bool" label="Enable local backups" default="true"/>
    <setting id="backup_count" type="number" label="Max local backups (1-20)" default="5"/>
  </category>
  <category id="advanced" label="Advanced">
    <setting id="timeout_sec" type="number" label="Network timeout (seconds)" default="15"/>
    <setting id="retry_count" type="number" label="Retry count" default="2"/>
  </category>
  <category id="logging" label="Logging">
    <setting id="log_level" type="enum" label="Log level" values="INFO|DEBUG" default="0"/>
    <setting id="log_network" type="bool" label="Include network trace (redacted)" default="false"/>
    <setting id="log_retention_days" type="number" label="Log retention (days)" default="7" option="int" min="1" max="30"/>
  </category>
  <category id="misc" label="Miscellaneous">
    <setting id="misc_add_to_fav" type="bool" label="Show addon in Favourites" default="false"/>
    <setting id="misc_keep_first" type="bool" label="Keep as first (if present)" default="false" visible="eq(-1,true)"/>
    <setting id="misc_group_addons_top" type="bool" label="Group addons at top" default="false"/>
    <setting id="misc_sort_addons" type="enum" label="Sort addons by" values="None|A-Z|Z-A|Manual" default="0"/>
    <setting id="misc_manual_order" type="action" label="Manual order editor..." action="RunScript(special://home/addons/plugin.service.favourites-sync/resources/lib/ui_manual_order.py)" visible="eq(-1,3)" option="close"/>
    <setting id="misc_run_reorder_now" type="action" label="Reorder Favourites now" action="RunScript(special://home/addons/plugin.service.favourites-sync/resources/lib/reorder_action.py)" option="close"/>
  </category>
  <category id="internal" label="Internal" visible="false">
    <setting id="first_run_done" type="bool" default="false" visible="false"/>
  </category>
</settings>
