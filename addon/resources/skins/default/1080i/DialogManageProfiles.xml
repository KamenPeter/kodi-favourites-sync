<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <allowoverlay>no</allowoverlay>

    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>

    <controls>
        <!-- Dim background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC000000">colors/black.png</texture>
        </control>

        <!-- Dialog panel -->
        <control type="group">
            <left>260</left>
            <top>140</top>
            <width>1400</width>
            <height>800</height>

            <!-- Background -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1400</width>
                <height>800</height>
                <texture border="20">dialogs/dialog-bg.png</texture>
            </control>

            <!-- Header -->
            <control type="label" id="10">
                <description>Title</description>
                <left>30</left>
                <top>20</top>
                <width>1340</width>
                <height>40</height>
                <font>font13_title</font>
                <textcolor>selected</textcolor>
                <label>32150</label> <!-- Manage Profiles -->
            </control>

            <!-- Separator line -->
            <control type="image">
                <left>30</left>
                <top>70</top>
                <width>1340</width>
                <height>2</height>
                <texture>dialogs/separator.png</texture>
            </control>

            <!-- Left: profiles list -->
            <control type="panel" id="50">
                <left>30</left>
                <top>90</top>
                <width>950</width>
                <height>630</height>
                <onleft>50</onleft>
                <onright>60</onright>
                <onup>50</onup>
                <ondown>50</ondown>
                <scrolltime>200</scrolltime>
                <itemlayout height="70" width="930">
                    <control type="label">
                        <left>10</left>
                        <top>10</top>
                        <width>600</width>
                        <height>50</height>
                        <font>font13</font>
                        <textcolor>grey2</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <aligny>center</aligny>
                    </control>
                    <control type="label">
                        <left>620</left>
                        <top>10</top>
                        <width>300</width>
                        <height>50</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>grey</textcolor>
                        <label>$INFO[ListItem.Property(status)]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="70" width="930">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>930</width>
                        <height>70</height>
                        <texture border="5">lists/focus.png</texture>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>10</top>
                        <width>600</width>
                        <height>50</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <aligny>center</aligny>
                    </control>
                    <control type="label">
                        <left>620</left>
                        <top>10</top>
                        <width>300</width>
                        <height>50</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>white</textcolor>
                        <label>$INFO[ListItem.Property(status)]</label>
                    </control>
                </focusedlayout>
            </control>

            <!-- Right: action buttons -->
            <control type="group">
                <left>1010</left>
                <top>90</top>
                <width>360</width>
                <height>630</height>

                <!-- Edit button -->
                <control type="button" id="60">
                    <left>0</left>
                    <top>0</top>
                    <width>360</width>
                    <height>50</height>
                    <font>font13</font>
                    <label>186</label> <!-- Edit -->
                    <onleft>50</onleft>
                    <onright>50</onright>
                    <onup>101</onup>
                    <ondown>61</ondown>
                </control>

                <!-- Validate button -->
                <control type="button" id="61">
                    <left>0</left>
                    <top>60</top>
                    <width>360</width>
                    <height>50</height>
                    <font>font13</font>
                    <label>32151</label> <!-- Validate Endpoint -->
                    <onleft>50</onleft>
                    <onright>50</onright>
                    <onup>60</onup>
                    <ondown>62</ondown>
                </control>

                <!-- Add button -->
                <control type="button" id="62">
                    <left>0</left>
                    <top>120</top>
                    <width>360</width>
                    <height>50</height>
                    <font>font13</font>
                    <label>32152</label> <!-- Add New Profile -->
                    <onleft>50</onleft>
                    <onright>50</onright>
                    <onup>61</onup>
                    <ondown>63</ondown>
                </control>

                <!-- Delete button -->
                <control type="button" id="63">
                    <left>0</left>
                    <top>180</top>
                    <width>360</width>
                    <height>50</height>
                    <font>font13</font>
                    <label>1210</label> <!-- Delete -->
                    <onleft>50</onleft>
                    <onright>50</onright>
                    <onup>62</onup>
                    <ondown>100</ondown>
                </control>

                <!-- Spacer -->

                <!-- OK button -->
                <control type="button" id="100">
                    <left>0</left>
                    <top>510</top>
                    <width>360</width>
                    <height>50</height>
                    <font>font13</font>
                    <label>186</label> <!-- OK -->
                    <onleft>50</onleft>
                    <onright>50</onright>
                    <onup>63</onup>
                    <ondown>101</ondown>
                </control>

                <!-- Cancel button -->
                <control type="button" id="101">
                    <left>0</left>
                    <top>570</top>
                    <width>360</width>
                    <height>50</height>
                    <font>font13</font>
                    <label>222</label> <!-- Cancel -->
                    <onleft>50</onleft>
                    <onright>50</onright>
                    <onup>100</onup>
                    <ondown>60</ondown>
                </control>
            </control>
        </control>
    </controls>
</window>
